{
  "info": {
    "name": "Disaster Response Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "All endpoints. Log in first — the response sets the auth cookies used by the rest of the collection."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "csrf", "value": "" },
    { "key": "disasterId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
    },
    {
      "name": "Auth — login as admin",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "const j = pm.response.json();",
          "pm.collectionVariables.set('csrf', j.data.csrfToken);"
        ]}
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": { "mode": "raw", "raw": "{\"username\":\"admin\",\"password\":\"Admin@12345\"}" }
      }
    },
    {
      "name": "Auth — me",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
    },
    {
      "name": "Auth — logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "x-csrf-token", "value": "{{csrf}}" }],
        "url": "{{baseUrl}}/api/auth/logout"
      }
    },
    {
      "name": "Disasters — list",
      "event": [{
        "listen": "test",
        "script": { "exec": [
          "const j = pm.response.json();",
          "if (j.data && j.data.length) pm.collectionVariables.set('disasterId', j.data[0].id);"
        ]}
      }],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/disasters?sort=recent&limit=20" }
    },
    {
      "name": "Disasters — filter by tag=flood",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/disasters?tag=flood" }
    },
    {
      "name": "Disasters — full-text search",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/disasters?q=manhattan" }
    },
    {
      "name": "Disasters — get one",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/disasters/{{disasterId}}" }
    },
    {
      "name": "Disasters — create (admin/contributor)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-csrf-token", "value": "{{csrf}}" }
        ],
        "url": "{{baseUrl}}/api/disasters",
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Flash flood in Brooklyn\",\n  \"description\": \"Storm surge flooding parts of Brooklyn\",\n  \"tags\": [\"flood\", \"storm\"],\n  \"status\": \"active\"\n}" }
      }
    },
    {
      "name": "Disasters — patch status",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-csrf-token", "value": "{{csrf}}" }
        ],
        "url": "{{baseUrl}}/api/disasters/{{disasterId}}",
        "body": { "mode": "raw", "raw": "{\"status\":\"monitoring\"}" }
      }
    },
    {
      "name": "Disasters — delete (admin only)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "x-csrf-token", "value": "{{csrf}}" }],
        "url": "{{baseUrl}}/api/disasters/{{disasterId}}"
      }
    },
    {
      "name": "Nearby resources (from disaster origin)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/disasters/{{disasterId}}/resources?radius=10" }
    },
    {
      "name": "Nearby resources (explicit coords)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/disasters/{{disasterId}}/resources?lat=40.7128&lng=-74.006&radius=25&type=shelter" }
    },
    {
      "name": "Reports (mock social)",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/disasters/{{disasterId}}/reports?limit=10" }
    },
    {
      "name": "Resources — flat list",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/resources?type=shelter" }
    },
    {
      "name": "SSE stream",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/events" }
    },
    {
      "name": "Negative — NoSQL injection payload rejected",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": { "mode": "raw", "raw": "{\"username\":{\"$ne\":null},\"password\":{\"$ne\":null}}" }
      }
    }
  ]
}
