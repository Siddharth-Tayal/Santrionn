{
  "name": "disaster-response",
  "version": "1.0.0",
  "private": true,
  "description": "Disaster Response Coordination Platform — Next.js 16 + Mongoose",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "seed": "node scripts/seed.js",
    "check:db": "node scripts/check-db.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --forceExit --coverage",
    "setup": "npm run check:db && npm install && npm run seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "node-mocks-http": "^1.16.2",
    "supertest": "^7.0.0"
  }
}
