# -----------------------------------------------------------------------------
# Disaster Response Platform — copy to .env and edit
# -----------------------------------------------------------------------------

NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/disaster_response

# Auth. Must be >= 32 chars. The dev sentinel below is REJECTED in production.
JWT_SECRET=dev-only-insecure-secret-must-be-replaced-000000
JWT_EXPIRES_IN=1h
AUTH_COOKIE_NAME=dr_access
CSRF_COOKIE_NAME=dr_csrf
CSRF_HEADER_NAME=x-csrf-token

# Location resolution: 'mock' (offline gazetteer) or 'nominatim' (live OSM)
GEOCODER_PROVIDER=mock
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
GEOCODER_TIMEOUT_MS=3000
GEOCODER_USER_AGENT=disaster-response/1.0

# Caching
CACHE_TTL_SECONDS=300
REPORTS_TTL_SECONDS=900
CACHE_MAX_ENTRIES=500

# Mock social provider
SOCIAL_API_BASE_URL=mock://social
SOCIAL_API_TIMEOUT_MS=2500
SOCIAL_API_FAILURE_RATE=0

# SSE
SSE_HEARTBEAT_MS=25000
SSE_MAX_CLIENTS=200

# Rate limits (per 15 min per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
WRITE_RATE_LIMIT_MAX=60

# Logging
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
